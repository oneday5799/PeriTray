#!/bin/sh
node tools/check.mjs || exit 1

# Rust 源有暂存改动时增量运行 rustfmt 与 cargo check（约定见 AGENTS.md Commit 规范）
if git diff --cached --name-only -- src-tauri/src src-tauri/Cargo.toml src-tauri/Cargo.lock | grep -q .; then
  echo "[pre-commit] Rust 改动，运行 cargo fmt --check..."
  if ! (cd src-tauri && cargo fmt --check) > /dev/null 2>&1; then
    echo "[pre-commit] 存在不符合 rustfmt 的格式，提交被拦截"
    echo "[pre-commit] 请执行: cd src-tauri && cargo fmt 后重新暂存"
    exit 1
  fi
  echo "[pre-commit] 运行 cargo check..."
  out=$(cd src-tauri && cargo check 2>&1) || {
    printf '%s\n' "$out"
    echo "[pre-commit] cargo check 失败，提交被拦截"
    exit 1
  }
  if printf '%s\n' "$out" | grep -q "^warning"; then
    printf '%s\n' "$out"
    echo "[pre-commit] cargo check 存在 warning（要求零警告），提交被拦截"
    exit 1
  fi
  printf '%s\n' "$out" | tail -1
  echo "[pre-commit] 运行 cargo clippy（存量基线见 tools/check-clippy.mjs）..."
  # --optional：本机没装 clippy 组件时告警跳过，避免环境问题卡死提交；
  # CI 调用同一条命令但**不带** --optional（硬失败），故本地跳过不会漏网。
  node tools/check-clippy.mjs --optional || exit 1
fi
